# Neon (Postgres)
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
# Desenvolvimento com Postgres local (opcional): DB_DRIVER="pg"

# Segredo da sessão (gere com: openssl rand -base64 32)
SESSION_SECRET="troque-por-um-segredo-longo"
# Segredo do cron de assinaturas (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="troque-tambem"
# Fuso da loja
TZ="America/Sao_Paulo"

# WhatsApp (evolution | zapi | none)
WHATSAPP_PROVIDER="none"
WHATSAPP_API_URL=""        # Evolution: https://sua-evolution.com
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE=""
ZAPI_INSTANCE=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# PIX automático (Mercado Pago) — vazio = chave PIX manual
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# URL pública (usada nos links do WhatsApp e no webhook)
NEXT_PUBLIC_SITE_URL="https://casa-de-racao-vvalmir-silvas-projects.vercel.app"

# Upload de fotos de produto (Vercel Blob) — vazio = só URL
BLOB_READ_WRITE_TOKEN=""
